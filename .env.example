# Copy to .env and adjust. Nothing here is required locally except
# DATABASE_URL/REDIS_URL inside Docker (compose sets those itself).

# API
PORT=3000
MAX_UPLOAD_BYTES=83886080

# Worker
WORKER_CONCURRENCY=2

# Pose extraction (worker). Without a model the worker fails jobs with an honest
# reason instead of pretending to analyse. Mount the model + wasm dir at ./models.
# pose_landmarker_lite: https://developers.google.com/mediapipe (see README).
# The tasks-vision wasm runtime files also go under ./models/wasm.

# Report paraphraser (optional; LLM must stay within the frozen templates)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Push notifications (optional; FCM)
FIREBASE_SERVICE_ACCOUNT_PATH=
